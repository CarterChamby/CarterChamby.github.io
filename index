// ════════════════════════════════════════════════
//  STATE
// ════════════════════════════════════════════════
let activeBook = 'paul';
let activeSec = PAUL[0].id;
let searchTerm = '';

// ════════════════════════════════════════════════
//  HELPERS
// ════════════════════════════════════════════════
function currentData() { return activeBook === 'paul' ? PAUL : MATTHEW; }

function hl(text) {
  if (!searchTerm) return text;
  const re = new RegExp('(' + searchTerm.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
  return text.replace(re, '<mark>$1</mark>');
}

function badgeHTML(badge) {
  if (!badge) return '';
  const map = { disc: ['badge-disc','Discourse'], narr: ['badge-narr','Narrative'], ot: ['badge-ot','OT Focus'] };
  if (!map[badge]) return '';
  return `<span class="badge ${map[badge][0]}">${map[badge][1]}</span>`;
}

// ════════════════════════════════════════════════
//  RENDER
// ════════════════════════════════════════════════
function renderAll() {
  renderBookBtns();
  renderLegend();
  renderSectionNav();
  renderList();
}

function renderBookBtns() {
  document.getElementById('btnPaul').className = 'book-btn' + (activeBook === 'paul' ? ' active' : '');
  document.getElementById('btnMatt').className = 'book-btn' + (activeBook === 'matthew' ? ' active' : '');
}

function renderLegend() {
  document.getElementById('legendBar').style.display = activeBook === 'matthew' && !searchTerm ? 'flex' : 'none';
}

function renderSectionNav() {
  const nav = document.getElementById('sectionNav');
  if (searchTerm) { nav.innerHTML = ''; return; }
  const data = currentData();
  nav.innerHTML = data.map(s =>
    `<button class="sec-tab ${s.id === activeSec ? 'active' : ''}" onclick="selectSec('${s.id}')">${s.name}</button>`
  ).join('');
}

function cardHTML(ch, showBookLabel) {
  return `<div class="card" onclick="toggleCard(this)">
    <div class="card-head">
      <div class="card-num">${ch.n}</div>
      <div class="card-main">
        ${ch.badge ? `<div class="badges">${badgeHTML(ch.badge)}</div>` : ''}
        <div class="card-title">${hl(ch.t)}</div>
        <div class="card-summary">${hl(ch.s)}</div>
      </div>
      <svg class="chevron" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>
    </div>
    <div class="card-body">
      <div class="detail-section">
        <div class="detail-label">Key arguments & themes</div>
        ${ch.args.map(a => `<div class="arg-item"><div class="arg-dot"></div><div class="arg-text">${hl(a)}</div></div>`).join('')}
      </div>
      ${ch.ot ? `<div class="ot-section"><strong style="display:block;margin-bottom:4px;font-size:11px;text-transform:uppercase;letter-spacing:0.06em;opacity:0.8;">OT Connections</strong>${hl(ch.ot)}</div>` : ''}
      ${ch.v ? `<div class="key-verse">${hl(ch.v)}</div>` : ''}
    </div>
  </div>`;
}

function renderList() {
  const area = document.getElementById('listArea');
  if (searchTerm) {
    let html = '';
    let count = 0;
    currentData().forEach(sec => {
      let secHTML = '';
      sec.chapters.forEach(ch => {
        const combined = (ch.t+' '+ch.s+' '+ch.args.join(' ')+(ch.ot||'')+(ch.v||'')).toLowerCase();
        if (combined.includes(searchTerm.toLowerCase())) {
          secHTML += cardHTML(ch, false);
          count++;
        }
      });
      if (secHTML) html += `<div class="result-book-label">${sec.name}</div>${secHTML}`;
    });
    area.innerHTML = count ? html : `<div class="no-results">No results for "${searchTerm}"</div>`;
    return;
  }
  const data = currentData();
  const sec = data.find(s => s.id === activeSec);
  if (!sec) return;
  area.innerHTML = `<div class="section-label">${sec.meta}</div>` + sec.chapters.map(ch => cardHTML(ch, false)).join('');
}

// ════════════════════════════════════════════════
//  INTERACTIONS
// ════════════════════════════════════════════════
function switchBook(book) {
  activeBook = book;
  activeSec = currentData()[0].id;
  searchTerm = '';
  document.getElementById('searchInput').value = '';
  renderAll();
}

function selectSec(id) {
  activeSec = id;
  document.getElementById('listArea').scrollTop = 0;
  renderSectionNav();
  renderList();
  // scroll the tab into view
  const tab = document.querySelector(`.sec-tab.active`);
  if (tab) tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
}

function onSearch() {
  searchTerm = document.getElementById('searchInput').value.trim();
  renderAll();
}

function toggleCard(card) {
  card.classList.toggle('open');
}

// init
renderAll();
</script>
</body>
</html>
